# Copy this file to ".env" (same folder).
# The .env file is gitignored — never commit real values.

# Only needed if the backend isn't on localhost:5050 -- e.g. testing on a
# physical device over LAN. Leave unset to use the default (see src/lib/coach.ts).
EXPO_PUBLIC_COACH_API_URL=http://192.168.1.X:5050
